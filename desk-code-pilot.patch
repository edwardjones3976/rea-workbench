+"""Admission for optional, explicitly pinned MIT source from REA."""
+from __future__ import annotations
+
+import hashlib
+import re
+from pathlib import Path
+
+from .workbench import MAX_FILE, Refusal, read_file
+
+REA_REPOSITORY = "https://github.com/morluto/rea"
+REA_RELEASE = "rea-agents-6.10.1"
+
+
+def admitted_files(catalog, names):
+    if not names:
+        return []
+    if not catalog or catalog.get("repository") != REA_REPOSITORY or catalog.get("release") != REA_RELEASE:
+        raise Refusal("REA source catalog does not match the pilot release")
+    if not re.fullmatch(r"[a-f0-9]{40}", catalog.get("commit", "")):
+        raise Refusal("Source catalog requires the exact upstream commit")
+    source = Path(catalog["source"]).resolve(strict=True)
+    components = []
+    for name in names:
+        if not isinstance(name, str) or not re.fullmatch(r"[a-z0-9_-]{1,48}", name):
+            raise Refusal("Invalid REA component name")
+        pins = catalog["components"].get(name)
+        if not isinstance(pins, dict) or "LICENSE" not in pins or not 2 <= len(pins) <= 40:
+            raise Refusal("REA component requires source pins and its license")
+        files = {}
+        for relative, digest in pins.items():
+            path = (source / relative).resolve(strict=True)
+            if (not re.fullmatch(r"[A-Za-z0-9_./-]{1,200}", relative)
+                    or relative.startswith("/") or ".." in Path(relative).parts
+                    or not path.is_relative_to(source) or not re.fullmatch(r"[a-f0-9]{64}", digest)):
+                raise Refusal("Invalid REA component path or pin")
+            data = read_file(path, 1024 * 1024)
+            if hashlib.sha256(data).hexdigest() != digest:
+                raise Refusal("REA source differs from its approved pin")
+            files[relative] = data
+        if b"MIT License" not in files["LICENSE"] or b"morluto" not in files["LICENSE"]:
+            raise Refusal("REA MIT license notice is missing")
+        components.append({"name": name, "files": files, "provenance": {
+            "component": name, "repository": REA_REPOSITORY, "release": REA_RELEASE,
+            "commit": catalog["commit"], "license": "MIT", "files": pins}})
+    return components
