+++ b/desk_code/workbench_export.py
@@ -0,0 +1,119 @@
+"""Portable, secret-free Workbench source and behavior bundle."""
+from __future__ import annotations
+
+import hashlib
+import json
+import secrets
+from pathlib import Path
+
+from .workbench import (
+    MAX_FILE, MAX_REPLY, MAX_TEXT, Refusal, atomic_json, bounded_json,
+    object_with, read_file, small_string, validate_recipe, validate_spec,
+)
+
+SCHEMA = "rea-workbench.bundle.v1"
+CLI = '''#!/usr/bin/env node
+import {readFileSync} from "node:fs";
+import {run} from "./index.ts";
+
+try {
+  if (process.env.WORKBENCH_DESK_RUN !== "1") throw new Error("Run this tool through Desk Code.");
+  const input = JSON.parse(readFileSync(0, "utf8"));
+  const output = await run(input);
+  process.stdout.write(JSON.stringify(output) + "\\n");
+} catch (error) {
+  process.stderr.write(String(error instanceof Error ? error.message : error) + "\\n");
+  process.exitCode = 1;
+}
+'''
+TEST = '''import assert from "node:assert/strict";
+import {readFileSync} from "node:fs";
+import {test} from "node:test";
+import {run} from "./index.ts";
+
+const spec = JSON.parse(readFileSync(new URL("./behavior.json", import.meta.url), "utf8"));
+for (const {name, input, expected} of spec.cases) {
+  test(name, async () => assert.deepEqual(await run(input), expected));
+}
+'''
+
+
+def export_project(wb, state):
+    if state["spec"] is None or state["approved"] != wb.revision(state["spec"]):
+        raise Refusal("Approve the current specification first")
+    if not state["code"]:
+        raise Refusal("Accept a reviewed implementation first")
+    if wb.runtime.redact(state["code"]) != state["code"]:
+        raise Refusal("Generated source contains credential-like material")
+    evidence = []
+    for record in state["evidence"]:
+        fields = {"id", "name", "sha256", "type", "inspection"}
+        evidence.append({key: val for key, val in record.items() if key in fields})
+    bundle = wb.runtime.redact_tree({
+        "schema": SCHEMA, "name": state["name"], "spec": state["spec"], "evidence": evidence,
+        "source": state["code"], "steps": state["steps"], "components": state["vendor"],
+    })
+    bounded_json(bundle, MAX_REPLY, "Export")
+    from .workbench_vendor import admitted_files
+    exports = wb.folder(state["id"]) / "exports"
+    exports.mkdir(exist_ok=True)
+    export_id = secrets.token_hex(8)
+    stage = exports / ("." + export_id)
+    destination = exports / export_id
+    vendor = admitted_files(wb.vendor, state["vendor"])
+    stage.mkdir()
+    atomic_json(stage / "bundle.json", bundle)
+    atomic_json(stage / "behavior.json", bundle["spec"])
+    atomic_json(stage / "recipe.json", bundle["steps"])
+    atomic_json(stage / "package.json", {"name": "workbench-generated-tool", "version": "0.1.0",
+                "private": True, "type": "module", "exports": "./index.ts",
+                "bin": {"workbench-generated-tool": "./cli.ts"},
+                "engines": {"node": ">=26.12.1"}})
+    for name, content in (("index.ts", bundle["source"]), ("cli.ts", CLI), ("behavior.test.ts", TEST),
+                          ("README.md", "# Exported Workbench tool\n\nImport bundle.json in a Desk Code"
+                           " Workbench installation. Review the specification and source before running."
+                           " index.ts is the editable library. cli.ts reads JSON on stdin.\n")):
+        (stage / name).write_text(content, encoding="utf-8")
+    if vendor:
+        atomic_json(stage / "provenance.json", [item["provenance"] for item in vendor])
+        for item in vendor:
+            for relative, content in item["files"].items():
+                path = stage / "vendor" / item["name"] / relative
+                path.parent.mkdir(parents=True, exist_ok=True)
+                path.write_bytes(content)
+    stage.rename(destination)
+    return {"path": str(destination), "bundle": str(destination / "bundle.json")}
+
+
+def import_project(wb, path):
+    data = json.loads(read_file(path, MAX_REPLY))
+    object_with(data, ("schema", "name", "spec", "evidence", "source", "steps", "components"))
+    if data["schema"] != SCHEMA:
+        raise Refusal("Unsupported bundle version")
+    name = small_string(data["name"], "project name", 100)
+    source = small_string(data["source"], "TypeScript", MAX_TEXT)
+    records = data["evidence"]
+    if not isinstance(records, list) or len(records) > 30:
+        raise Refusal("Invalid evidence index")
+    refs = set()
+    for item in records:
+        if not isinstance(item, dict):
+            raise Refusal("Invalid evidence record")
+        fields = ("id", "name", "sha256", "type", "inspection") if item.get("type") == "artifact" else ("id", "name", "sha256", "type")
+        object_with(item, fields)
+        ref = small_string(item["id"], "evidence ID", 48)
+        if ref in refs or item["type"] not in ("artifact", "observation"):
+            raise Refusal("Invalid evidence index")
+        refs.add(ref)
+        bounded_json(item, MAX_TEXT, "Evidence metadata")
+    spec = validate_spec(data["spec"], refs)
+    steps = validate_recipe(data["steps"]) if data["steps"] else []
+    if not isinstance(data["components"], list) or not all(isinstance(v, str) for v in data["components"]):
+        raise Refusal("Invalid component references")
+    from .workbench_vendor import admitted_files
+    admitted_files(wb.vendor, data["components"])
+    id = wb.create(name)["id"]
+    state = wb.state(id)
+    state.update({"spec": spec, "evidence": records, "steps": steps, "vendor": data["components"],
+                  "draft": {"source": source, "revision": wb.revision(source)}})
+    return wb.save(state)
diff --git a/desk_code/workbench_mcp_client.py b/desk_code/workbench_mcp_client.py
new file mode 100644
--- /dev/null
+++ b/desk_code/workbench_mcp_client.py
@@ -0,0 +1,53 @@
+"""Fixed local MCP stdio client run by the Workbench Desk Code supervisor."""
+import json
+import subprocess
+import sys
+from pathlib import Path
+
+LIMIT = 2 * 1024 * 1024
+
+
+def receive(pipe, id):
+    for _ in range(32):
+        raw = pipe.readline(LIMIT + 1)
+        if not raw or len(raw) > LIMIT:
+            raise ValueError("Unavailable or oversized MCP reply")
+        item = json.loads(raw)
+        if item.get("id") == id:
+            if "error" in item or "result" not in item:
+                raise ValueError("Local MCP replied with an error")
+            return item["result"]
+    raise ValueError("MCP response did not match the request")
+
+
+def send(pipe, value):
+    pipe.write(json.dumps(value).encode() + b"\n")
+    pipe.flush()
+
+
+def main():
+    data = json.loads(sys.stdin.buffer.read(LIMIT))
+    argv = data["argv"]
+    if not argv or not Path(argv[0]).is_absolute() or Path(argv[0]).suffix.lower() in (".cmd", ".bat", ".ps1"):
+        raise ValueError("Approved native executable required")
+    initialize, initialized, call = data["messages"]
+    with subprocess.Popen(argv, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
+                          stderr=subprocess.DEVNULL) as proc:
+        try:
+            send(proc.stdin, initialize)
+            info = receive(proc.stdout, 1)
+            if (info.get("protocolVersion") != initialize["params"]["protocolVersion"]
+                    or "tools" not in info.get("capabilities", {})):
+                raise ValueError("Unsupported local MCP capabilities")
+            send(proc.stdin, initialized)
+            send(proc.stdin, call)
+            result = receive(proc.stdout, 2)
+            if result.get("isError"):
+                raise ValueError("Local MCP tool failed")
+            print(json.dumps(result.get("structuredContent", result.get("content"))))
+        finally:
+            proc.terminate()
+
+
+if __name__ == "__main__":
+    main()
diff --git a/desk_code/workbench_runtime.py b/desk_code/workbench_runtime.py
new file mode 100644
--- /dev/null
+++ b/desk_code/workbench_runtime.py
@@ -0,0 +1,213 @@
+"""Desk Code's fixed Workbench runtime for the private pilot."""
+from __future__ import annotations
+
+import json
+import os
+import re
+import secrets
+import subprocess
+import tempfile
+import time
+from pathlib import Path
+from urllib import error, parse, request
+
+from .workbench import MAX_REPLY, MAX_TEXT, NoRedirect, Refusal, bounded_json
+from .winproc import hidden_creationflags
+
+LOCAL_ENGINE = "npipe:////./pipe/dockerDesktopLinuxEngine"
+IMAGE = "node@sha256:0042e17d232a87a2cd485be1da7900fca4d10a4ad11b29e9285da1d2e54798c9"
+SANDBOX_SCRIPT = r"""
+import {readFileSync, writeFileSync} from "node:fs";
+import {spawnSync} from "node:child_process";
+const input = JSON.parse(readFileSync(0, "utf8"));
+writeFileSync("/tmp/index.ts", input.source, { mode: 0o600 });
+if (typeof input.cli === "string") {
+  writeFileSync("/tmp/cli.ts", input.cli, { mode: 0o600 });
+  const child = spawnSync(process.execPath, ["/tmp/cli.ts"], {
+    input: JSON.stringify(input.value), encoding: "utf8", timeout: 12000,
+    maxBuffer: 1024 * 1024, env: { WORKBENCH_DESK_RUN: "1" },
+  });
+  if (child.status !== 0) throw new Error("Exported command failed");
+  process.stdout.write(JSON.stringify({result:JSON.parse(child.stdout)}));
+} else {
+  const {run} = await import("file:///tmp/index.ts");
+  if (typeof run !== "function") throw new Error("Missing named export run");
+  const result = await run(input.value);
+  process.stdout.write(JSON.stringify({result}));
+}
+"""
+AUTH_RE = re.compile(
+    r"(?i)\b(?:bearer\s+[A-Za-z0-9._~+/\-=]+|(?:api[_ -]?key|password|token|authorization|secret)"
+    r"\s*[:=]\s*['\"]?[^,\s}\"']+|sk-[A-Za-z0-9_-]{12,})"
+)
+
+
+class Runtime:
+    def __init__(self, config, cancellation):
+        self.config = config
+        self.cancel = cancellation
+        self.models = config["models"]
+        for model in self.models.values():
+            endpoint = parse.urlsplit(model["endpoint"])
+            if model["cloud"]:
+                if model["endpoint"] != "https://api.openai.com/v1/chat/completions":
+                    raise Refusal("Pilot cloud endpoint must be the OpenAI API")
+            elif (endpoint.scheme != "http" or endpoint.hostname not in ("127.0.0.1", "::1")
+                  or endpoint.username or endpoint.password or endpoint.query or endpoint.fragment):
+                raise Refusal("Pilot local model endpoint must be an explicit loopback HTTP URL")
+
+    @staticmethod
+    def executable(args):
+        if not isinstance(args, list) or not args or not all(isinstance(value, str) for value in args):
+            raise Refusal("Invalid approved executable")
+        executable = Path(args[0])
+        if not executable.is_absolute() or not executable.is_file() or executable.suffix.lower() in (".cmd", ".bat", ".ps1"):
+            raise Refusal("Approved operation requires a fixed native executable")
+        return args
+
+    def redact(self, value):
+        for connection in self.models.values():
+            key = os.environ.get(connection.get("key_env", ""), "")
+            if key:
+                value = value.replace(key, "[redacted]")
+        return AUTH_RE.sub("[redacted]", value)
+
+    def redact_tree(self, value):
+        if isinstance(value, str):
+            return self.redact(value)
+        if isinstance(value, list):
+            return [self.redact_tree(v) for v in value]
+        if isinstance(value, dict):
+            return {self.redact(k): self.redact_tree(v) for k, v in value.items()}
+        return value
+
+    def check(self):
+        if self.cancel.is_set():
+            raise Refusal("Cancelled locally. An already-issued model request may have completed.")
+
+    def run(self, argv, payload=b"", timeout=25, clean=None):
+        self.check()
+        # Command programs receive a minimal host environment. Model keys remain in the supervisor.
+        allowed = {"systemroot", "windir", "temp", "tmp", "userprofile", "appdata",
+                   "localappdata", "path", "home", "docker_config"}
+        env = {key: value for key, value in os.environ.items() if key.lower() in allowed}
+        with tempfile.TemporaryFile() as stdin, tempfile.TemporaryFile() as out, tempfile.TemporaryFile() as err:
+            stdin.write(payload)
+            stdin.seek(0)
+            child = subprocess.Popen(self.executable(argv), stdin=stdin, stdout=out, stderr=err,
+                                     cwd=Path(argv[0]).parent, env=env, creationflags=hidden_creationflags())
+            try:
+                deadline = time.monotonic() + timeout
+                while child.poll() is None:
+                    self.check()
+                    if time.monotonic() >= deadline:
+                        raise Refusal("Operation exceeded its time limit")
+                    if os.fstat(out.fileno()).st_size + os.fstat(err.fileno()).st_size > MAX_REPLY:
+                        raise Refusal("Operation exceeded its output limit")
+                    time.sleep(.04)
+                self.check()
+                if child.returncode:
+                    raise Refusal("Approved operation exited with status " + str(child.returncode))
+                out.seek(0)
+                payload = out.read(MAX_REPLY + 1)
+                if len(payload) > MAX_REPLY:
+                    raise Refusal("Operation exceeded its output limit")
+                try:
+                    return json.loads(payload)
+                except (ValueError, UnicodeError) as exc:
+                    raise Refusal("Approved operation returned invalid JSON") from exc
+            finally:
+                if child.poll() is None:
+                    child.kill()
+                    child.wait(timeout=5)
+                    if clean:
+                        subprocess.run(clean, capture_output=True, timeout=8, env=env,
+                                       creationflags=hidden_creationflags(), check=False)
+
+    def inspect(self, path, suffix):
+        cli = self.config["rea"]
+        command = "inspect-pe-resources" if suffix in (".exe", ".dll") else "inspect-artifact"
+        args = [*cli, command, str(path), "--format", "json"]
+        if command == "inspect-artifact":
+            args += ["--filter-output", "evidence_id,operation,subject.identity,limitations"]
+        evidence = self.run(args)
+        if not isinstance(evidence, dict) or not evidence.get("evidence_id"):
+            raise Refusal("REA did not return an evidence identifier")
+        subject = evidence.get("subject") or {}
+        identity = subject.get("identity") or {}
+        result = {"evidenceId": evidence["evidence_id"], "operation": evidence.get("operation"),
+                  "format": identity.get("format"), "architecture": identity.get("architecture"),
+                  "coverage": self.redact_tree(evidence.get("limitations", []))}
+        normalized = evidence.get("normalized_result") or {}
+        result["details"] = {key: value for key, value in normalized.items()
+                             if key in {"resource_count", "file_count", "entry_count", "artifact_type", "format"}
+                             and isinstance(value, (str, int))}
+        return result
+
+    def model(self, connection, prompt, payload):
+        self.check()
+        model = self.models[connection]
+        key = os.environ.get(model.get("key_env", ""), "")
+        if model["cloud"] and not key:
+            raise Refusal("The selected cloud credential is unavailable")
+        messages = [{"role": "system", "content": prompt},
+                    {"role": "user", "content": bounded_json(payload, 2 * MAX_TEXT, "Model request")}]
+        data = json.dumps({"model": model["model"], "messages": messages}).encode()
+        headers = {"Content-Type": "application/json"}
+        if key:
+            headers["Authorization"] = "Bearer " + key
+        client = request.build_opener(request.ProxyHandler({}), NoRedirect())
+        req = request.Request(model["endpoint"], data=data, headers=headers, method="POST")
+        try:
+            with client.open(req, timeout=30) as response:
+                raw = response.read(MAX_REPLY + 1)
+        except error.HTTPError as exc:
+            raise Refusal("Model returned HTTP " + str(exc.code)) from exc
+        except (error.URLError, TimeoutError) as exc:
+            raise Refusal("Model unavailable or request outcome unknown. No automatic retry.") from exc
+        self.check()
+        if len(raw) > MAX_REPLY:
+            raise Refusal("Model reply exceeded its size limit")
+        try:
+            text = json.loads(raw)["choices"][0]["message"]["content"]
+            return json.loads(text)
+        except (IndexError, KeyError, TypeError, ValueError) as exc:
+            raise Refusal("Model did not return the requested JSON") from exc
+
+    def generated(self, source, value, cli=None):
+        docker = self.config["docker"]
+        name = "desk-workbench-" + secrets.token_hex(8)
+        base = [docker, "--host", LOCAL_ENGINE]
+        arguments = [*base, "run", "--rm", "--name", name, "--pull=never", "-i",
+                     "--network=none", "--read-only", "--tmpfs", "/tmp:rw,noexec,nosuid,size=16m",
+                     "--cap-drop=ALL", "--security-opt=no-new-privileges",
+                     "--user=65534:65534", "--pids-limit=32", "--memory=192m", "--cpus=1",
+                     IMAGE, "node", "--disable-warning=ExperimentalWarning", "--input-type=module",
+                     "-e", SANDBOX_SCRIPT]
+        payload = bounded_json({"source": source, "value": value, "cli": cli}, 2 * MAX_TEXT, "Generated input").encode()
+        result = self.run(arguments, payload, timeout=32, clean=[*base, "rm", "-f", name])
+        if not isinstance(result, dict) or set(result) != {"result"}:
+            raise Refusal("Generated tool did not return one JSON result")
+        return result["result"]
+
+    def local(self, value):
+        if not self.config.get("local"):
+            raise Refusal("No local plugin is approved for this Desk Code installation")
+        return self.run(self.config["local"], bounded_json(value, MAX_TEXT, "Local input").encode())
+
+    def mcp(self, value):
+        if not self.config.get("mcp"):
+            raise Refusal("No local MCP step is approved for this Desk Code installation")
+        target = self.config["mcp"]
+        requests = [
+            {"jsonrpc": "2.0", "id": 1, "method": "initialize",
+             "params": {"protocolVersion": "2025-11-25", "capabilities": {},
+                        "clientInfo": {"name": "rea-workbench", "version": "0.1.0"}}},
+            {"jsonrpc": "2.0", "method": "notifications/initialized"},
+            {"jsonrpc": "2.0", "id": 2, "method": "tools/call",
+             "params": {"name": target["tool"], "arguments": {"input": value}}},
+        ]
+        # The fixed stdio client performs and checks handshake, then one named tool call.
+        args = self.config["mcp_client"]
+        payload = bounded_json({"argv": target["argv"], "messages": requests}, 2 * MAX_TEXT, "MCP input")
+        return self.run(args, payload.encode())
diff --git a/desk_code/workbench_supervisor.py b/desk_code/workbench_supervisor.py
new file mode 100644
--- /dev/null
+++ b/desk_code/workbench_supervisor.py
@@ -0,0 +1,160 @@
+"""Launch REA Workbench through a private Desk Code stdio supervisor."""
+from __future__ import annotations
+
+import argparse
+import hmac
+import json
+import os
+import secrets
+import sqlite3
+import subprocess
+import sys
+import threading
+import time
+import uuid
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+from contextlib import closing
+from pathlib import Path
+
+from .workbench import MAX_REPLY, Refusal, Workbench, bounded_json, object_with, read_file
+from .workbench_runtime import Runtime
+from .winproc import hidden_creationflags
+
+
+class Supervisor:
+    def __init__(self, config):
+        self.cancel = threading.Event()
+        self.runtime = Runtime(config, self.cancel)
+        self.wb = Workbench(Path(config["projects"]), Path(config["imports"]),
+                            self.runtime, config.get("vendor"))
+        self.receipts = self.wb.store / "receipts.sqlite"
+        with closing(sqlite3.connect(self.receipts)) as db, db:
+            db.execute("CREATE TABLE IF NOT EXISTS receipts (id TEXT PRIMARY KEY, "
+                       "op TEXT NOT NULL, status TEXT NOT NULL, started REAL NOT NULL, finished REAL)")
+
+    def perform(self, op, args):
+        id = uuid.uuid4().hex
+        started = time.time()
+        with closing(sqlite3.connect(self.receipts)) as db, db:
+            db.execute("INSERT INTO receipts VALUES(?,?,?,?,NULL)", (id, op, "running", started))
+        try:
+            result = self.wb.dispatch(op, args)
+            bounded_json(result, MAX_REPLY - 1024, "Response")
+            body = {"ok": True, "value": result}
+            status = "completed"
+        except (Refusal, ValueError, TypeError, OSError, KeyError) as exc:
+            text = str(exc) if isinstance(exc, Refusal) else "Invalid or unavailable Workbench input"
+            body = {"ok": False, "error": self.runtime.redact(text)[:600]}
+            status = "cancelled" if self.cancel.is_set() else "refused"
+        except Exception:
+            body = {"ok": False, "error": "Unexpected Desk Code failure. Review the receipt before retrying."}
+            status = "error"
+        with closing(sqlite3.connect(self.receipts)) as db, db:
+            db.execute("UPDATE receipts SET status=?, finished=? WHERE id=?", (status, time.time(), id))
+        body["receipt"] = {"id": id, "backend": "desk-code-workbench", "operation": op, "status": status}
+        return body
+
+    def launch(self, electron, app_dir, smoke=False):
+        if electron.name.lower() != "electron.exe" or not electron.is_file():
+            raise Refusal("A fixed installed Electron launcher is required")
+        env = {k: v for k, v in os.environ.items() if k.lower() in {
+            "systemroot", "windir", "temp", "tmp", "userprofile", "appdata", "localappdata", "path"}}
+        token = secrets.token_urlsafe(32)
+        expected = "Bearer " + token
+        operation = threading.Lock()
+        supervisor = self
+
+        class SessionHandler(BaseHTTPRequestHandler):
+            def log_message(self, *_):
+                pass
+
+            def reply(self, code, body):
+                data = bounded_json(body, MAX_REPLY, "Wire response").encode()
+                self.send_response(code)
+                self.send_header("Content-Type", "application/json")
+                self.send_header("Cache-Control", "no-store")
+                self.send_header("Content-Length", str(len(data)))
+                self.end_headers()
+                try:
+                    self.wfile.write(data)
+                except (ConnectionError, OSError):
+                    pass
+
+            def do_POST(self):
+                self.connection.settimeout(8)
+                header = self.headers.get("Authorization", "")
+                if (self.path != "/workbench/v1" or not header.isascii()
+                        or not hmac.compare_digest(header, expected)):
+                    self.reply(403, {"ok": False, "error": "Desk Code session authorization required"})
+                    return
+                try:
+                    size = int(self.headers.get("Content-Length", "0"))
+                    if not 0 < size <= MAX_REPLY or self.headers.get("Content-Type") != "application/json":
+                        raise Refusal("Invalid Workbench request")
+                    message = object_with(json.loads(self.rfile.read(size)), ("op", "args"))
+                    op, args = message["op"], message["args"]
+                    if op == "cancel":
+                        object_with(args, ())
+                        supervisor.cancel.set()
+                        body = {"ok": True, "value": {"requested": True}}
+                    elif not isinstance(op, str) or op not in supervisor.wb.operations:
+                        raise Refusal("Unknown Workbench operation")
+                    elif not operation.acquire(blocking=False):
+                        self.reply(409, {"ok": False, "error": "Another operation is still active"})
+                        return
+                    else:
+                        try:
+                            supervisor.cancel.clear()
+                            body = supervisor.perform(op, args)
+                        finally:
+                            operation.release()
+                    self.reply(200, body)
+                except (Refusal, ValueError, TypeError, TimeoutError):
+                    self.reply(400, {"ok": False, "error": "Invalid Workbench request"})
+
+        with ThreadingHTTPServer(("127.0.0.1", 0), SessionHandler) as server:
+            server.daemon_threads = False
+            env["WORKBENCH_DESK_PORT"] = str(server.server_port)
+            env["WORKBENCH_DESK_SESSION"] = token
+            argv = [str(electron), str(app_dir)]
+            if smoke:
+                argv.append("--pilot-ui-smoke")
+            thread = threading.Thread(target=server.serve_forever, daemon=True)
+            thread.start()
+            started = time.monotonic()
+            proc = None
+            try:
+                proc = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stderr=sys.stderr,
+                                        cwd=str(app_dir), env=env, creationflags=hidden_creationflags())
+                status = proc.wait(timeout=35 if smoke else None)
+                if smoke:
+                    print(json.dumps({"ready": status == 0, "exit": status,
+                                      "backend": "desk-code-workbench",
+                                      "milliseconds": int(1000 * (time.monotonic() - started))}))
+                return status
+            finally:
+                supervisor.cancel.set()
+                if proc is not None and proc.poll() is None:
+                    proc.kill()
+                    proc.wait(timeout=5)
+                server.shutdown()
+                thread.join(timeout=5)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--config", type=Path, required=True)
+    parser.add_argument("--app", type=Path, required=True)
+    parser.add_argument("--electron", type=Path, required=True)
+    parser.add_argument("--smoke", action="store_true")
+    args = parser.parse_args()
+    config = json.loads(read_file(args.config.resolve(strict=True), MAX_REPLY))
+    app = args.app.resolve(strict=True)
+    electron = args.electron.resolve(strict=True)
+    if not (app / "dist" / "main.js").is_file() or not electron.is_relative_to(app):
+        parser.error("Build the Workbench app and install its fixed Electron launcher first")
+    return Supervisor(config).launch(electron, app, args.smoke)
+
+
+if __name__ == "__main__":
+    sys.exit(main())
